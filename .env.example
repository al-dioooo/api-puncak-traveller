APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api-puncak-traveller.test
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=puncak_traveller
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,api-puncak-traveller.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP password reset delivery.
# Create a Google App Password, then set MAIL_PASSWORD to that 16-character app password.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@puncaktraveller.id"
MAIL_FROM_NAME="${APP_NAME}"

MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=SB-Mid-server-PLACEHOLDER
MIDTRANS_CLIENT_KEY=SB-Mid-client-PLACEHOLDER
MIDTRANS_NOTIFICATION_URL="${APP_URL}/api/v1/payments/midtrans/notification"
MIDTRANS_SNAP_API_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_SNAP_JS_URL=https://app.sandbox.midtrans.com/snap/snap.js
MIDTRANS_STATUS_API_BASE_URL=https://api.sandbox.midtrans.com/v2

PUNCAK_ADMIN_EMAIL=alice@puncaktraveller.id
PUNCAK_ADMIN_PASSWORD=aldio1234
PUNCAK_ADMIN_NAME="Puncak Administrator"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

POSTMAN_SPEC_ID=
POSTMAN_SPEC_FILE_PATH=openapi.yaml
POSTMAN_COLLECTION_UID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_MOBILE_REDIRECT_URI=http://localhost:8000/api/v1/auth/mobile/google/callback
